PORT=3000
# The address you type in the browser.
# Use your homelab HTTPS name, such as https://hub.home.example.
# Do not add a path or a trailing slash.
# Use http://localhost:3000 only before the proxy is ready.
SITE_URL=http://localhost:3000
# Set to 1 to show adults when a newer GitHub release exists. Off by default.
# This sends the server address and check time to GitHub. It never installs an update.
# FAMILY_HUB_UPDATE_CHECK=1
DATABASE_PATH=./data/family-hub.sqlite
HOUSEHOLD_NAME=Our Home
SESSION_DAYS=30
# Optional AnyList and Google Calendar connections: a separate random 32-byte key,
# encoded as 64 hex characters. Keep it outside the database and retain it securely
# for backup recovery.
# FAMILY_HUB_INTEGRATION_KEY=
# Optional Google Calendar fallback. OAuth credentials can instead be saved in
# Settings → Integrations. Create a Google OAuth web client and register
# https://your-hub.example/api/integrations/google-calendar/callback.
# Google OAuth needs HTTPS; localhost is allowed for local testing.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Bootstrap with npm run bootstrap -- --email ... --name ... (password is prompted)
