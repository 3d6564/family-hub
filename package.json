{
  "name": "family-hub",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "bootstrap": "node src/bootstrap.js",
    "pairing-code": "node src/pairing-code.js",
    "test": "node --test --test-concurrency=1",
    "check": "node --check src/server.js && node --check src/release.js && node --check src/updates.js && node --check src/app.js && node --check public/app.js && node --check public/routine-view.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "node-ical": "^0.27.2"
  }
}
